              "host": ["{{baseUrl}}"],
              "path": ["stocks", "{{stockId}}", "candles"],
              "query": [
                { "key": "interval", "value": "ONE_MINUTE", "description": "ONE_MINUTE | THREE_MINUTE | FIVE_MINUTE | TEN_MINUTE | FIFTEEN_MINUTE | THIRTY_MINUTE | ONE_HOUR | ONE_DAY" },
                { "key": "limit", "value": "390", "description": "Max candles to return (used for MongoDB fallback only)" }
              ]
            },
            "description": "Get OHLCV candlestick data for charting.\n\nPrimary: fetches from AngelOne historical API (requires active session).\nFallback: returns stored 1-min candles from MongoDB.\n\nDate range is auto-calculated per interval:\n- ONE_MINUTE → last 1 day\n- FIVE_MINUTE → last 5 days\n- FIFTEEN_MINUTE → last 10 days\n- ONE_HOUR → last 30 days\n- ONE_DAY → last 365 days\n\nResponse candles are formatted for lightweight-charts:\n`{ time (unix seconds), open, high, low, close, volume }`"
          }
        },
        {
          "name": "Get Historical Data (Manual Range)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/stocks/{{stockId}}/historical?interval=ONE_DAY&fromdate=2024-01-01 09:15&todate=2024-01-31 15:30",
              "host": ["{{baseUrl}}"],
              "path": ["stocks", "{{stockId}}", "historical"],
              "query": [
                { "key": "interval", "value": "ONE_DAY" },
                { "key": "fromdate", "value": "2024-01-01 09:15", "description": "IST time: YYYY-MM-DD HH:MM" },
                { "key": "todate", "value": "2024-01-31 15:30", "description": "IST time: YYYY-MM-DD HH:MM" }
              ]
            },
            "description": "Fetch raw candle data from AngelOne with manual date range. Requires active AngelOne session.\nDates must be in IST (India Standard Time): `YYYY-MM-DD HH:MM`"
